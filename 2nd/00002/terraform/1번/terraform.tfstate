            "definition": "{\n  \"Comment\": \"wsc2026 student score processing workflow\",\n  \"StartAt\": \"CheckS3File\",\n  \"States\": {\n    \"CheckS3File\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::aws-sdk:s3:headObject\",\n      \"Parameters\": {\n        \"Bucket\": \"wsc2026-student-score-bucket-101\",\n        \"Key.$\": \"$.key\"\n      },\n      \"ResultPath\": null,\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\"States.ALL\"],\n          \"ResultPath\": \"$.error\",\n          \"Next\": \"FileNotFound\"\n        }\n      ],\n      \"Next\": \"ProcessStudentData\"\n    },\n\n    \"ProcessStudentData\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"arn:aws:lambda:ap-southeast-1:412869002243:function:wsc2026-student-score-function\",\n        \"Payload\": {\n          \"key.$\": \"$.key\"\n        }\n      },\n      \"ResultSelector\": {\n        \"statusCode.$\": \"$.Payload.statusCode\",\n        \"processed.$\": \"$.Payload.processed\",\n        \"errors.$\": \"$.Payload.errors\"\n      },\n      \"ResultPath\": \"$.result\",\n      \"Retry\": [\n        {\n          \"ErrorEquals\": [\n            \"Lambda.ServiceException\",\n            \"Lambda.AWSLambdaException\",\n            \"Lambda.SdkClientException\",\n            \"Lambda.TooManyRequestsException\",\n            \"States.TaskFailed\"\n          ],\n          \"IntervalSeconds\": 2,\n          \"MaxAttempts\": 3,\n          \"BackoffRate\": 2\n        }\n      ],\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\"States.ALL\"],\n          \"ResultPath\": \"$.error\",\n          \"Next\": \"MoveToError\"\n        }\n      ],\n      \"Next\": \"CheckResult\"\n    },\n\n    \"CheckResult\": {\n      \"Type\": \"Choice\",\n      \"Choices\": [\n        {\n          \"Variable\": \"$.result.statusCode\",\n          \"NumericEquals\": 200,\n          \"Next\": \"MoveToProcessed\"\n        }\n      ],\n      \"Default\": \"MoveToError\"\n    },\n\n    \"MoveToProcessed\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::aws-sdk:s3:copyObject\",\n      \"Parameters\": {\n        \"Bucket\": \"wsc2026-student-score-bucket-101\",\n        \"CopySource.$\": \"States.Format('wsc2026-student-score-bucket-101/{}', $.key)\",\n        \"Key.$\": \"States.Format('processed/{}', States.ArrayGetItem(States.StringSplit($.key, '/'), 1))\"\n      },\n      \"ResultPath\": null,\n      \"Next\": \"DeleteInputAfterProcessed\"\n    },\n\n    \"DeleteInputAfterProcessed\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::aws-sdk:s3:deleteObject\",\n      \"Parameters\": {\n        \"Bucket\": \"wsc2026-student-score-bucket-101\",\n        \"Key.$\": \"$.key\"\n      },\n      \"ResultPath\": null,\n      \"End\": true\n    },\n\n    \"MoveToError\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::aws-sdk:s3:copyObject\",\n      \"Parameters\": {\n        \"Bucket\": \"wsc2026-student-score-bucket-101\",\n        \"CopySource.$\": \"States.Format('wsc2026-student-score-bucket-101/{}', $.key)\",\n        \"Key.$\": \"States.Format('error/{}', States.ArrayGetItem(States.StringSplit($.key, '/'), 1))\"\n      },\n      \"ResultPath\": null,\n      \"Next\": \"DeleteInputAfterError\"\n    },\n\n    \"DeleteInputAfterError\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::aws-sdk:s3:deleteObject\",\n      \"Parameters\": {\n        \"Bucket\": \"wsc2026-student-score-bucket-101\",\n        \"Key.$\": \"$.key\"\n      },\n      \"ResultPath\": null,\n      \"Next\": \"WorkflowFailed\"\n    },\n\n    \"WorkflowFailed\": {\n      \"Type\": \"Fail\",\n      \"Error\": \"StudentScoreProcessingFailed\",\n      \"Cause\": \"Lambda processing failed or returned a non-200 statusCode.\"\n    },\n\n    \"FileNotFound\": {\n      \"Type\": \"Fail\",\n      \"Error\": \"InputFileNotFound\",\n      \"Cause\": \"Input CSV file does not exist in the S3 input/ prefix.\"\n    }\n  }\n}\n",
