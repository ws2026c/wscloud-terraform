# cp terraform.tfvars.example terraform.tfvars 후 반드시 본인 비번호로 수정할 것!
# 채점 1-1 / 1-3 / 1-5 가 모두 버킷 이름을 기준으로 하므로 비번호가 틀리면 전부 오답 처리됩니다.
region         = "ap-southeast-1"
student_number = "103" # -> wsc2026-student-score-bucket-103

# 버킷 이름을 직접 지정하려면 아래 주석 해제
# bucket_name = "wsc2026-student-score-bucket-103"
