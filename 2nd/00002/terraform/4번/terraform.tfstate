            "placement_group": "",
            "placement_group_id": "",
            "placement_partition_number": 0,
            "primary_network_interface": [
              {
                "delete_on_termination": true,
                "network_interface_id": "eni-058a1b4f0751008f6"
              }
            ],
            "primary_network_interface_id": "eni-058a1b4f0751008f6",
            "private_dns": "ip-192-168-10-16.ap-northeast-1.compute.internal",
            "private_dns_name_options": [
              {
                "enable_resource_name_dns_a_record": false,
                "enable_resource_name_dns_aaaa_record": false,
