          "schema_version": 0,
          "attributes": {
            "id": "3535761160",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"SaveSensorData\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"dynamodb:PutItem\",\n      \"Resource\": \"arn:aws:dynamodb:ap-northeast-1:412869002243:table/wsc2026-sensor-data\"\n    },\n    {\n      \"Sid\": \"PublishAlert\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"sns:Publish\",\n      \"Resource\": \"arn:aws:sns:ap-northeast-1:412869002243:wsc2026-sensor-alert-topic\"\n    },\n    {\n      \"Sid\": \"SaveAlertLog\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:PutObject\",\n      \"Resource\": \"arn:aws:s3:::wsc2026-sensor-alert-bucket-111/alert/*\"\n    },\n    {\n      \"Sid\": \"MskConnect\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"kafka-cluster:DescribeClusterDynamicConfiguration\",\n        \"kafka-cluster:DescribeCluster\",\n        \"kafka-cluster:Connect\"\n      ],\n      \"Resource\": \"arn:aws:kafka:ap-northeast-1:412869002243:cluster/wsc2026-msk-cluster/347e5bcf-bbc3-44f0-941c-62ecac634e6d-3\"\n    },\n    {\n      \"Sid\": \"MskTopicReadWrite\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"kafka-cluster:WriteData\",\n        \"kafka-cluster:ReadData\",\n        \"kafka-cluster:DescribeTopicDynamicConfiguration\",\n        \"kafka-cluster:DescribeTopic\"\n      ],\n      \"Resource\": \"arn:aws:kafka:ap-northeast-1:412869002243:topic/wsc2026-msk-cluster/347e5bcf-bbc3-44f0-941c-62ecac634e6d-3/*\"\n    },\n    {\n      \"Sid\": \"MskConsumerGroup\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"kafka-cluster:DescribeGroup\",\n        \"kafka-cluster:AlterGroup\"\n      ],\n      \"Resource\": \"arn:aws:kafka:ap-northeast-1:412869002243:group/wsc2026-msk-cluster/347e5bcf-bbc3-44f0-941c-62ecac634e6d-3/*\"\n    },\n    {\n      \"Sid\": \"GetBootstrapBrokers\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"kafka:GetBootstrapBrokers\",\n        \"kafka:DescribeCl