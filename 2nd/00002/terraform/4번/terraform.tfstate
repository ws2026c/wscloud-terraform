    "check_commands": {
      "value": "export AWS_DEFAULT_REGION=ap-northeast-1\nCLUSTER_ARN=arn:aws:kafka:ap-northeast-1:412869002243:cluster/wsc2026-msk-cluster/347e5bcf-bbc3-44f0-941c-62ecac634e6d-3\nBUCKET_NAME=wsc2026-sensor-alert-bucket-111\n\naws kafka describe-cluster --cluster-arn $CLUSTER_ARN \\\n  --query \"ClusterInfo.[ClusterName,State,CurrentBrokerSoftwareInfo.KafkaVersion,BrokerNodeGroupInfo.InstanceType,ClientAuthentication.Sasl.Iam.Enabled]\" --output text\n\naws dynamodb scan --table-name wsc2026-sensor-data --max-items 1 \\\n  --query \"Items[0].{sensorId:sensorId.S,temperature:temperature.S,status:status.S}\" --output json\n",
      "type": "string"
    },
