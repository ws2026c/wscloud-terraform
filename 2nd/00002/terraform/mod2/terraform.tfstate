            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"ReadOrderStream\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"kinesis:SubscribeToShard\",\n        \"kinesis:RegisterStreamConsumer\",\n        \"kinesis:ListShards\",\n        \"kinesis:GetShardIterator\",\n        \"kinesis:GetRecords\",\n        \"kinesis:DescribeStreamSummary\",\n        \"kinesis:DescribeStreamConsumer\",\n        \"kinesis:DescribeStream\",\n        \"kinesis:DeregisterStreamConsumer\"\n      ],\n      \"Resource\": [\n        \"arn:aws:kinesis:ap-northeast-2:412869002243:stream/wsc2026-order-stream/*\",\n        \"arn:aws:kinesis:ap-northeast-2:412869002243:stream/wsc2026-order-stream\"\n      ]\n    },\n    {\n      \"Sid\": \"GlueCatalog\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"glue:UpdateTable\",\n        \"glue:UpdateDatabase\",\n        \"glue:GetUserDefinedFunctions\",\n        \"glue:GetUserDefinedFunction\",\n        \"glue:GetTables\",\n        \"glue:GetTable\",\n        \"glue:GetPartitions\",\n        \"glue:GetPartition\",\n        \"glue:GetDatabases\",\n        \"glue:GetDatabase\",\n        \"glue:GetConnections\",\n        \"glue:GetConnection\",\n        \"glue:DeleteTable\",\n        \"glue:CreateTable\",\n        \"glue:CreatePartition\",\n        \"glue:CreateDatabase\",\n        \"glue:BatchCreatePartition\"\n      ],\n      \"Resource\": [\n        \"arn:aws:glue:ap-northeast-2:412869002243:userDefinedFunction/wsc2026_analytics_db/*\",\n        \"arn:aws:glue:ap-northeast-2:412869002243:userDefinedFunction/hive/*\",\n        \"arn:aws:glue:ap-northeast-2:412869002243:userDefinedFunction/default/*\",\n        \"arn:aws:glue:ap-northeast-2:412869002243:table/wsc2026_analytics_db/*\",\n        \"arn:aws:glue:ap-northeast-2:412869002243:table/hive/*\",\n        \"arn:aws:glue:ap-northeast-2:412869002243:table/default/*\",\n        \"arn:aws:glue:ap-northeast-2:412869002243:database/w