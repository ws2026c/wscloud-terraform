            "id": "837700435",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"Logs\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"logs:PutLogEvents\",\n        \"logs:CreateLogStream\",\n        \"logs:CreateLogGroup\"\n      ],\n      \"Resource\": \"arn:aws:logs:eu-west-1:412869002243:log-group:/aws/lambda/wsc2026-*\"\n    },\n    {\n      \"Sid\": \"PublishAlert\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"sns:Publish\",\n      \"Resource\": \"arn:aws:sns:eu-west-1:412869002243:wsc2026-event-alert\"\n    },\n    {\n      \"Sid\": \"DescribeResources\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ec2:DescribeTags\",\n        \"ec2:DescribeSecurityGroups\",\n        \"ec2:DescribeSecurityGroupRules\",\n        \"ec2:DescribeInstances\",\n        \"ec2:DescribeInstanceStatus\",\n        \"ec2:DescribeIamInstanceProfileAssociations\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"RemediateSecurityGroup\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ec2:RevokeSecurityGroupIngress\",\n      \"Resource\": \"arn:aws:ec2:eu-west-1:412869002243:security-group/sg-0e6ced721ba71f493\"\n    },\n    {\n      \"Sid\": \"RemediateInstance\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ec2:StopInstances\",\n        \"ec2:StartInstances\",\n        \"ec2:ModifyInstanceAttribute\",\n        \"ec2:CreateTags\"\n      ],\n      \"Resource\": \"arn:aws:ec2:eu-west-1:412869002243:instance/i-07abb6789705eab83\"\n    },\n    {\n      \"Sid\": \"RemediateInstanceProfile\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ec2:ReplaceIamInstanceProfileAssociation\",\n        \"ec2:DisassociateIamInstanceProfile\",\n        \"ec2:AssociateIamInstanceProfile\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"PassEc2Role\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"iam:PassRole\",\n      \"Resource\": \"arn:aws:iam::412869002243:role/wsc2026-event-ec2-role\"\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"Logs\",\"Effect\":\"Allow\",\"Action\":[\"logs:PutLogEvents\",\"logs:CreateLogStream\",\"logs:CreateLogGroup\"],\"Resource\":\"arn:aws:logs:eu-west-1:412869002243:log-group:/aws/lambda/wsc2026-*\"},{\"Sid\":\"PublishAlert\",\"Effect\":\"Allow\",\"Action\":\"sns:Publish\",\"Resource\":\"arn:aws:sns:eu-west-1:412869002243:wsc2026-event-alert\"},{\"Sid\":\"DescribeResources\",\"Effect\":\"Allow\",\"Action\":[\"ec2:DescribeTags\",\"ec2:DescribeSecurityGroups\",\"ec2:DescribeSecurityGroupRules\",\"ec2:DescribeInstances\",\"ec2:DescribeInstanceStatus\",\"ec2:DescribeIamInstanceProfileAssociations\"],\"Resource\":\"*\"},{\"Sid\":\"RemediateSecurityGroup\",\"Effect\":\"Allow\",\"Action\":\"ec2:RevokeSecurityGroupIngress\",\"Resource\":\"arn:aws:ec2:eu-west-1:412869002243:security-group/sg-0e6ced721ba71f493\"},{\"Sid\":\"RemediateInstance\",\"Effect\":\"Allow\",\"Action\":[\"ec2:StopInstances\",\"ec2:StartInstances\",\"ec2:ModifyInstanceAttribute\",\"ec2:CreateTags\"],\"Resource\":\"arn:aws:ec2:eu-west-1:412869002243:instance/i-07abb6789705eab83\"},{\"Sid\":\"RemediateInstanceProfile\",\"Effect\":\"Allow\",\"Action\":[\"ec2:ReplaceIamInstanceProfileAssociation\",\"ec2:DisassociateIamInstanceProfile\",\"ec2:AssociateIamInstanceProfile\"],\"Resource\":\"*\"},{\"Sid\":\"PassEc2Role\",\"Effect\":\"Allow\",\"Action\":\"iam:PassRole\",\"Resource\":\"arn:aws:iam::412869002243:role/wsc2026-event-ec2-role\"}]}",
