    "remediation_test_commands": {
      "value": "export AWS_DEFAULT_REGION=eu-west-1\nINSTANCE_ID=i-07abb6789705eab83\nSG_ID=sg-0e6ced721ba71f493\n\naws ec2 stop-instances --instance-ids $INSTANCE_ID\naws ec2 authorize-security-group-ingress --group-id $SG_ID --protocol tcp --port 22 --cidr 0.0.0.0/0\n\n# 2~3분 후\naws ec2 describe-instances --instance-ids $INSTANCE_ID --query \"Reservations[0].Instances[0].State.Name\" --output text\naws ec2 describe-security-groups --group-ids $SG_ID --query \"SecurityGroups[0].IpPermissions | length(@)\" --output text\n",
      "type": "string"
    },
    "security_group_id": {
      "value": "sg-0e6ced721ba71f493",
      "type": "string"
    },
    "sns_topic_arn": {
